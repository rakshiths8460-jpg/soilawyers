# ==============================================================================
# Society of Indian Lawyers (SIL) Environment Variables
# ==============================================================================

# Database Configuration (Neon Postgres Serverless)
# If omitted or invalid, the platform automatically uses a local persistent JSON store.
DATABASE_URL="postgres://user:password@ep-sample-project.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Razorpay API Credentials
# Retrieve from Razorpay Dashboard -> Settings -> API Keys (Key ID & Secret)
RAZORPAY_KEY_ID="rzp_test_your_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"

# Public Client-side Razorpay Key ID
# Must match RAZORPAY_KEY_ID above (exposed safely to the client for the checkout popup)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id_here"

# Razorpay Webhook Secret
# Set in Razorpay Dashboard -> Settings -> Webhooks
# Webhook URL to configure in Razorpay: https://yourdomain.com/api/webhooks/razorpay
# Subscribed Events: payment.captured, order.paid, payment.failed
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret_phrase_here"
